<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="css/video.css" />
  </head>

  <body>
    <div class="video-wrapper-outer">
      <div class="video-wrapper" id="video-wrapper">
        <div class="video-box">
          <div class="video-title" id="title"></div>
          <video id="video"></video>
        </div>

        <div class="controls">
          <button onclick="prevVideo()">⏮</button>
          <button onclick="togglePlay()">▶ / ❚❚</button>
          <button onclick="nextVideo()">⏭</button>
          <button id="muteBtn" onclick="toggleMute()">🔊</button>

          <input type="range" id="progress" value="0" />

          <select onchange="changeSpeed(this.value)">
            <option value="0.5">0.5x</option>
            <option value="1" selected>1x</option>
            <option value="1.5">1.5x</option>
            <option value="2">2x</option>
          </select>

          <button onclick="fullscreen()">⛶</button>
        </div>
      </div>
    </div>
    <script>
      window.videos = <%- JSON.stringify(videos) %>;
    </script>
    <script src="/js/video.js"></script>
  </body>
</html>
