<div class="max-w-7xl mx-auto p-4 md:p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <div class="bg-gray-50 rounded-xl p-4 shadow-inner">
            <h2 class="text-xl font-bold text-gray-800 mb-4 border-b-2 border-gray-200 pb-2">
                Contact Inquiries
            </h2>
            
            <div class="flex flex-col gap-4">
                <% if (contacts && contacts.length > 0) { %>
                    <% contacts.forEach(contact => { %>
                        <div class="bg-white p-5 rounded-lg border border-gray-100 shadow-sm hover:shadow-md transition-shadow duration-200">
                            <div class="flex justify-between items-start mb-1">
                                <h3 class="font-semibold text-gray-900"><%= contact.name %></h3>
                                <span class="text-xs text-gray-400"><%= new Date(contact.createdAt).toLocaleDateString() %></span>
                            </div>
                            
                            <div class="text-xs text-gray-500 mb-2"><%= contact.email %></div>
                            
                            <div class="text-sm font-medium text-blue-600 mb-1">
                                <%= contact.subject || 'General Inquiry' %>
                            </div>
                            
                            <p class="text-sm text-gray-600 line-clamp-2 mb-4">
                                <%= contact.message %>
                            </p>
                            
                            <a href="/admin/feedback&contact/contact/<%= contact._id %>" class="block w-full text-center bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white text-sm font-medium py-2 px-4 rounded transition-colors duration-200">
                                View Full Detail
                            </a>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-gray-500 text-sm text-center py-4 italic">No contact inquiries found.</p>
                <% } %>
            </div>
        </div>

        <div class="bg-gray-50 rounded-xl p-4 shadow-inner">
            <h2 class="text-xl font-bold text-gray-800 mb-4 border-b-2 border-gray-200 pb-2">
                User Feedback
            </h2>
            
            <div class="flex flex-col gap-4">
                <% if (feedbacks && feedbacks.length > 0) { %>
                    <% feedbacks.forEach(feedback => { %>
                        <div class="bg-white p-5 rounded-lg border border-gray-100 shadow-sm hover:shadow-md transition-shadow duration-200">
                            <div class="flex justify-between items-center mb-3">
                                <span class="px-2.5 py-1 text-xs font-semibold rounded-full 
                                    <%= feedback.type === 'Bug Report' ? 'bg-red-100 text-red-700' : 
                                        feedback.type === 'Feature Request' ? 'bg-green-100 text-green-700' : 
                                        'bg-purple-100 text-purple-700' %>">
                                    <%= feedback.type %>
                                </span>
                                
                                <span class="text-yellow-500 font-bold text-sm flex items-center gap-1">
                                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                    <%= feedback.rating %>/5
                                </span>
                            </div>
                            
                            <div class="text-xs text-gray-500 mb-2">
                                From: <%= feedback.email || 'Anonymous' %>
                            </div>
                            
                            <p class="text-sm text-gray-600 line-clamp-2 mb-4">
                                <%= feedback.message %>
                            </p>
                            
                            <div class="flex gap-2 items-center">
                                <% if (feedback.screenshot && feedback.screenshot.mediaUrl) { %>
                                    <div class="bg-gray-100 text-gray-600 text-xs px-2 py-2 rounded flex items-center" title="Includes Screenshot">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    </div>
                                <% } %>
                                
                                <a href="/admin/feedback&contact/feedback/<%= feedback._id %>" class="flex-1 text-center bg-indigo-50 text-indigo-700 hover:bg-indigo-600 hover:text-white text-sm font-medium py-2 px-4 rounded transition-colors duration-200">
                                    View Full Detail
                                </a>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-gray-500 text-sm text-center py-4 italic">No feedback received yet.</p>
                <% } %>
            </div>
        </div>
        
    </div>
</div>