<div class="bg-white rounded-2xl shadow-xl overflow-hidden w-full max-w-4xl flex flex-col md:flex-row h-[600px] md:h-[650px]">
        
        <div class="hidden md:block w-1/2 bg-cover bg-center relative login-bg-image">
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-8 text-white">
                <h2 class="text-3xl font-bold mb-2">Welcome Back.</h2>
                <p class="text-gray-200">Join our community and experience the difference today.</p>
            </div>
        </div>

        <div class="w-full md:w-1/2 p-8 md:p-12 flex flex-col justify-center relative bg-white">
            
            <div id="loginForm" class="fade-in w-full">
                <div class="text-center mb-8">
                    <h2 class="text-3xl font-bold text-gray-900">Sign In</h2>
                    <p class="text-gray-500 mt-2">Please enter your details.</p>
                </div>

                <form id="signInForm" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                        <input type="email" placeholder="enter your email" class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-300 focus:border-blue-500 focus:bg-white focus:outline-none transition duration-200" required>
                    </div>
                    
                    <div class="relative">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                        <input type="password" id="loginPass" placeholder="••••••••" class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-300 focus:border-blue-500 focus:bg-white focus:outline-none transition duration-200" required>
                        <i class="fa-regular fa-eye absolute right-4 top-[38px] text-gray-400 cursor-pointer hover:text-gray-600 toggle-password" data-target="loginPass"></i>
                    </div>

                    <div class="flex justify-end">
                        <button type="button" class="text-sm font-medium text-blue-600 hover:text-blue-500 switch-to-forgot">Forgot password?</button>
                    </div>

                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg transition duration-300 shadow-md transform active:scale-[0.98]">
                        Sign In
                    </button>

                    <a href="/auth/google" type="button" class="w-full border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 font-medium py-3 rounded-lg transition duration-300 flex items-center justify-center gap-2">
                        <img src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-5 h-5" alt="Google">
                        Sign in with Google
                    </a>
                    
                </form>
                <p class="text-center text-sm text-gray-600 mt-8" id="errorMsg"></p>
                <p class="text-center text-sm text-gray-600 mt-8">
                    Don't have an account? 
                    <button class="font-bold text-blue-600 hover:underline switch-to-signup">Sign up for free</button>
                </p>
            </div>

            <div id="signupForm" class="hidden-form fade-in w-full">
                <div class="text-center mb-6">
                    <h2 class="text-3xl font-bold text-gray-900">Create Account</h2>
                    <span class="text-gray-500 mt-2"></span>
                </div>

                <form id="signUpForm" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                        <input type="text" placeholder="Enter Your Name" class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-300 focus:border-blue-500 focus:bg-white focus:outline-none transition duration-200" required>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                        <input type="email" placeholder="Enter Your Email" class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-300 focus:border-blue-500 focus:bg-white focus:outline-none transition duration-200" required>
                    </div>
                    
                    <div class="relative">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                        <input type="password" id="signupPass" placeholder="Create a password" class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-300 focus:border-blue-500 focus:bg-white focus:outline-none transition duration-200" required>
                        <i class="fa-regular fa-eye absolute right-4 top-[38px] text-gray-400 cursor-pointer hover:text-gray-600 toggle-password" data-target="signupPass"></i>
                    </div>

                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg transition duration-300 shadow-md transform active:scale-[0.98]">
                        Create Account
                    </button>

                    <a href="/auth/google" type="button" class="w-full border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 font-medium py-3 rounded-lg transition duration-300 flex items-center justify-center gap-2">
                        <img src="https://www.svgrepo.com/show/475656/google-color.svg" class="w-5 h-5" alt="Google">
                        Sign up with Google
                    </a>
                </form>
                <p class="text-center text-lg text-red-800 mt-8" id="errorMsg1"></p>
                <p class="text-center text-sm text-gray-600 mt-6">
                    Already have an account? 
                    <button class="font-bold text-blue-600 hover:underline switch-to-login">Log in</button>
                </p>
            </div>

            <div id="forgotForm" class="hidden-form fade-in w-full text-center">
                <div class="mb-6">
                    <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fa-solid fa-key text-2xl text-blue-600"></i>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-900">Forgot Password?</h2>
                    <p class="text-gray-500 mt-2">No worries, we'll send you reset instructions.</p>
                </div>

                <form id="forgotPassForm" class="space-y-4">
                    <div>
                        <label class="text-left block text-sm font-medium text-gray-700 mb-1">Email</label>
                        <input type="email" placeholder="Enter your email" class="w-full px-4 py-3 rounded-lg bg-gray-50 border border-gray-300 focus:border-blue-500 focus:bg-white focus:outline-none transition duration-200" required>
                    </div>

                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg transition duration-300 shadow-md">
                        Reset Password
                    </button>
                </form>

                <p class="text-center text-sm text-gray-600 mt-8">
                    <button class="font-medium text-gray-600 hover:text-gray-900 flex items-center justify-center gap-2 mx-auto switch-to-login">
                        <i class="fa-solid fa-arrow-left"></i> Back to log in
                    </button>
                </p>
            </div>

        </div>
    </div>