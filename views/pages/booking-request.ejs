  <div class="max-w-6xl mx-auto mb-40">
    <h1 class="text-2xl font-bold mb-6 pt-10 text-gray-900">Manage Booking Requests</h1>
    
    <div class="overflow-x-auto bg-white shadow-sm rounded-lg border border-gray-200">
      <table class="min-w-full text-left border-collapse">
        <thead class="bg-gray-100 border-b border-gray-200">
          <tr>
            <th class="py-3 px-4 font-semibold text-sm text-gray-700">Booking ID</th>
            <th class="py-3 px-4 font-semibold text-sm text-gray-700">Customer Details</th>
            <th class="py-3 px-4 font-semibold text-sm text-gray-700">Booking Date</th>
            <th class="py-3 px-4 font-semibold text-sm text-gray-700">Current Status</th>
            <th class="py-3 px-4 font-semibold text-sm text-gray-700">See More</th>
          </tr>
        </thead>
        <tbody>
          <% if (bookings && bookings.length > 0) { %>
            <% bookings.forEach(function(booking) { %>
              <tr class="hover:bg-gray-50 transition-colors border-b border-gray-100 last:border-0">
                
                <td class="py-3 px-4 text-sm font-medium text-gray-900">
                  <%= booking._id %>
                </td>
                
                <td class="py-3 px-4 text-sm text-gray-700">
                  <strong><%= booking.fullName || booking.email %></strong>
                </td>
                
                <td class="py-3 px-4 text-sm text-gray-500">
                  <%= new Date(booking.createdAt).toLocaleDateString() %>
                </td>
                
                <td class="py-3 px-4 text-sm">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                    <%= booking.status === 'Pending' ? 'bg-yellow-100 text-yellow-800' : 
                        booking.status === 'Confirmed' ? 'bg-blue-100 text-blue-800' : 
                        booking.status === 'Completed' ? 'bg-green-100 text-green-800' : 
                        'bg-red-100 text-red-800' %>">
                    <%= booking.status %>
                  </span>
                </td>
                
                <td class="py-3 px-4 text-sm">
                        <a href="/admin/booking-request/<%= booking._id %>" 
                              class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-4 py-1.5 rounded text-sm font-medium transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1 text-center">
                              View Details
                        </a>
                  </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="5" class="py-8 px-4 text-center text-sm text-gray-500">
                No booking requests found.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

