<!DOCTYPE html>
<html>
  <head>
    <title>Admin Login</title>
    <style>
      * {
        box-sizing: border-box;
        font-family: "Segoe UI", Tahoma, sans-serif;
      }

      body {
        height: 100vh;
        margin: 0;
        background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .admin-box {
        width: 360px;
        padding: 35px;
        background: #0b1320;
        border-radius: 10px;
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
      }

      .admin-box h2 {
        text-align: center;
        color: #00e6e6;
        margin-bottom: 10px;
        letter-spacing: 1px;
      }
      .error-msg {
        display: none;
        margin-bottom: 15px;
        padding: 10px;
        border-radius: 6px;
        background: rgba(255, 77, 77, 0.15);
        color: #ff4d4d;
        font-size: 13px;
        text-align: center;
        border: 1px solid rgba(255, 77, 77, 0.4);
      }
      .admin-box p {
        text-align: center;
        font-size: 13px;
        color: #9aa4b2;
        margin-bottom: 25px;
      }

      .admin-box input {
        width: 100%;
        padding: 12px;
        margin-bottom: 15px;
        background: transparent;
        border: 1px solid #1f2a44;
        border-radius: 6px;
        color: #fff;
        outline: none;
      }

      .admin-box input::placeholder {
        color: #6c7a92;
      }

      .admin-box input:focus {
        border-color: #00e6e6;
        box-shadow: 0 0 5px #00e6e6;
      }

      .admin-box button {
        width: 100%;
        padding: 12px;
        background: #00e6e6;
        border: none;
        border-radius: 6px;
        font-weight: bold;
        letter-spacing: 1px;
        cursor: pointer;
        color: #0b1320;
        transition: 0.3s;
      }

      .admin-box button:hover {
        background: #00b3b3;
      }

      .admin-footer {
        margin-top: 20px;
        text-align: center;
        font-size: 12px;
        color: #5f6f8b;
      }
    </style>
  </head>
  <body>
    <div class="admin-box">
      <h2>ADMIN ACCESS</h2>
      <p>Authorized personnel only</p>
      <div id="errorMsg" class="error-msg"></div>
      <form id="adminLoginForm">
        <input type="email" id="email" placeholder="Admin Email" required />
        <input type="password" id="password" placeholder="Password" required />
        <button type="submit">LOGIN</button>
      </form>

      <div class="admin-footer">© Secure Admin Panel</div>
    </div>

    <script>
      // const form = document.getElementById("adminLoginForm");
      // const errorBox = document.getElementById("errorMsg");

      // form.addEventListener("submit", async (e) => {
      //   e.preventDefault();

      //   // Clear old error
      //   errorBox.style.display = "none";
      //   errorBox.textContent = "";

      //   try {
      //     const res = await fetch("/api/auth/admin/login", {
      //       method: "POST",
      //       headers: { "Content-Type": "application/json" },
      //       body: JSON.stringify({
      //         email: email.value,
      //         password: password.value,
      //       }),
      //     });

      //     const data = await res.json();

      //     if (!res.ok) {
      //       errorBox.textContent = data.message || "Login failed";
      //       errorBox.style.display = "block";
      //       return;
      //     }

      //     // ✅ Success
      //     localStorage.setItem("adminToken", data.token);
      //     window.location.href = "/api/upload";
      //   } catch (err) {
      //     errorBox.textContent = "Something went wrong. Please try again.";
      //     errorBox.style.display = "block";
      //   }
      // });
      const form = document.getElementById("adminLoginForm");
      const errorBox = document.getElementById("errorMsg");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        errorBox.style.display = "none";
        errorBox.textContent = "";

        try {
          const res = await fetch("/api/auth/admin/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              email: email.value,
              password: password.value,
            }),
          });

          console.log("Response status:", res.status);

          const text = await res.text(); // 👈 READ RAW RESPONSE
          console.log("Raw response:", text);

          let data;
          try {
            data = JSON.parse(text);
          } catch (e) {
            errorBox.textContent = "Server returned invalid response";
            errorBox.style.display = "block";
            return;
          }

          if (!res.ok) {
            errorBox.textContent = data.message || "Login failed";
            errorBox.style.display = "block";
            return;
          }

          localStorage.setItem("adminToken", data.token);
          window.location.href = "  /upload";
        } catch (err) {
          console.error("FETCH ERROR:", err);
          errorBox.textContent = "Network / server error";
          errorBox.style.display = "block";
        }
      });
    </script>
  </body>
</html>
