
<div class="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8 font-sans">
  
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Booking Details</h1>
    <a href="/admin/booking-request" class="text-blue-600 hover:text-blue-800 text-sm font-medium flex items-center gap-1">
      &larr; Back to all bookings
    </a>
  </div>

  <div class="bg-white shadow-md rounded-xl border border-gray-200 overflow-hidden">
    
    <div class="bg-gray-50 px-6 py-4 border-b border-gray-200 flex justify-between items-center">
      <span class="text-sm font-medium text-gray-500">Booking ID: <span class="text-gray-900"><%= booking._id %></span></span>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium 
        <%= booking.status === 'Pending' ? 'bg-yellow-100 text-yellow-800' : 
            booking.status === 'Confirmed' ? 'bg-blue-100 text-blue-800' : 
            booking.status === 'Completed' ? 'bg-green-100 text-green-800' : 
            'bg-red-100 text-red-800' %>">
        <%= booking.status %>
      </span>
    </div>

    <div class="p-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-6">Customer & Trip Information</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8 mb-8">
        
        <div>
          <p class="text-sm text-gray-500 mb-1">Customer Name</p>
          <p class="font-medium text-gray-900"><%= booking.userName || booking.name || 'N/A' %></p>
        </div>
        
        <div>
          <p class="text-sm text-gray-500 mb-1">Customer Email</p>
          <p class="font-medium text-gray-900"><%= booking.email || 'N/A' %></p>
        </div>

        <div>
          <p class="text-sm text-gray-500 mb-1">Phone Number</p>
          <p class="font-medium text-gray-900"><%= booking.phone || 'N/A' %></p>
        </div>

        <div>
          <p class="text-sm text-gray-500 mb-1">Destination / Package</p>
          <p class="font-medium text-gray-900"><%= booking.destination || 'N/A' %></p>
        </div>

        <div>
          <p class="text-sm text-gray-500 mb-1">Number of Guests</p>
          <p class="font-medium text-gray-900"><%= booking.guests || 1 %></p>
        </div>

        <div>
          <p class="text-sm text-gray-500 mb-1">Booking Request Date</p>
          <p class="font-medium text-gray-900"><%= new Date(booking.createdAt).toLocaleString() %></p>
        </div>

      </div>

      <% if (booking.message || booking.specialRequests) { %>
        <div class="mb-8 bg-gray-50 p-4 rounded-lg border border-gray-100">
          <p class="text-sm text-gray-500 mb-2">Special Requests / Message</p>
          <p class="text-gray-800 text-sm whitespace-pre-wrap"><%= booking.message || booking.specialRequests %></p>
        </div>
      <% } %>

      <hr class="border-gray-200 mb-6">

      <div class="bg-blue-50/50 p-6 rounded-lg border border-blue-100">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Manage Booking Status</h2>
        
        <form action="/admin/booking-request/<%= booking._id %>/status" method="POST" class="flex flex-col sm:flex-row items-start sm:items-end gap-4">
          
          <div class="flex flex-col w-full sm:w-auto">
            <label for="status" class="text-sm text-gray-700 font-medium mb-2">Update Status To:</label>
            <select name="status" id="status" required 
                    class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 min-w-[250px] shadow-sm 
                    <%= booking.status === 'Cancelled' ? 'bg-gray-100 cursor-not-allowed text-gray-500' : 'bg-white cursor-pointer' %>"
                    <%= booking.status === 'Cancelled' ? 'disabled' : '' %>>
              <option value="Pending" <%= booking.status === 'Pending' ? 'selected' : '' %>>Pending</option>
              <option value="Confirmed" <%= booking.status === 'Confirmed' ? 'selected' : '' %>>Confirmed</option>
              <option value="Completed" <%= booking.status === 'Completed' ? 'selected' : '' %>>Completed</option>
              <option value="Cancelled" <%= booking.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
            </select>
          </div>
          
          <button type="submit" 
                  class="w-full sm:w-auto mt-4 sm:mt-0 px-6 py-2.5 rounded-lg text-sm font-medium transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 text-white
                  <%= booking.status === 'Cancelled' ? 'bg-blue-400 cursor-not-allowed opacity-70' : 'bg-blue-600 hover:bg-blue-700' %>"
                  <%= booking.status === 'Cancelled' ? 'disabled' : '' %>>
            Save Changes
          </button>

        </form>
      </div>

    </div>
  </div>
</div>