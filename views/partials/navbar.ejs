<header class="header">
  <nav>
    <div class="nav-container">
      <div class="logo">HiddenBihar</div>

      <%
       const isLoggedIn = !!user;
        const isAdmin = user && user.role === 'admin';
      %>

  <ul class="nav-menu" id="navMenu">
  <li><a href="/" class="nav-link">Home</a></li>

  <% if (isAdmin) { %>
    <li>
      <a href="/booking-request" class="nav-link">Booking Request</a>
    </li>
        <% } else { %>
          <li><a href="/about" class="nav-link">About</a></li>
          <li><a href="/services" class="nav-link">Services</a></li>
          <li><a href="/pricing" class="nav-link">Pricing</a></li>
          <li><a href="/contact" class="nav-link">Contact</a></li>
        <% } %>

          <li>
        <% if (isAdmin) { %>
          <a href="/upload" class="nav-profile-link" title="Admin Dashboard" style="margin-right: 15px; font-weight: bold; color: #007bff;">
            Admin Panel
          </a>
        <% } else if (isLoggedIn) { %>
          <a href="/profile" class="nav-profile-link" title="Profile">
            <img
            src="<%= user.photo ? user.photo : `https://i.pravatar.cc/150?u=${user._id}` %>"
            alt="Profile"
            class="nav-profile-icon" />
          </a>
        <% } else { %>
           <a href="/auth" class="login-btn">Login</a>
        <% } %>

        <% if (isLoggedIn) { %>
              <form action="/api/auth/logout" method="POST" style="display: inline">
                <button type="submit" id="logout">Logout</button>
              </form>
            <% } %>
          </li>
        </ul>


      <div class="hamburger" id="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>
  </nav>
</header>
